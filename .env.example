# Elasticsearch Configuration
ES_HOST=your_elasticsearch_host
ES_PORT=9200
ES_SCHEME=http
ES_USER=your_username
ES_PASSWORD=your_password

# Upstage API Configuration (REQUIRED for embeddings)
UPSTAGE_API_KEY=your_upstage_api_key

# Benchmark API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key

# MCP Server endpoint used by the benchmark scripts
# Default assumes a locally self-hosted server: MCP_TRANSPORT=sse python -m src.server
MCP_SERVER_URL=http://localhost:8000/sse
